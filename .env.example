# All variables below are REQUIRED. The app validates them at start-up and
# refuses to boot if any are missing or malformed (see lib/env.ts).

# Origin of the Todo API (demo-backend). Must point at the backend, not at this
# app — the backend listens on its own PORT, 5000 by default.
API_BASE_URL="http://localhost:5000"

# Must match the backend's COOKIE_NAME exactly. A mismatch makes every visitor
# look signed out, with no error to explain why.
SESSION_COOKIE_NAME="todo_session"
