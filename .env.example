# The one variable this app needs. It is REQUIRED: the server validates it at
# start-up and refuses to boot if it is missing or malformed (see lib/env.ts).

# Origin of the Todo API (demo-backend). Must point at the backend, not at this
# app — the backend listens on its own PORT, 5000 by default.
#
# NEXT_PUBLIC_ is deliberate. The browser calls the API directly, so this origin
# is compiled into the client bundle. Nothing secret may ever go in here.
#
# The backend must allow this app's origin in CORS for those calls to succeed:
# set CORS_ORIGIN=http://localhost:3000 in demo-backend/.env.
NEXT_PUBLIC_API_BASE_URL="http://localhost:5000"
